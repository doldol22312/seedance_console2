# Active provider: "ark" (Volcano Engine Ark / Seedance) or "dashscope" (Alibaba Model Studio / Wan)
PROVIDER=ark

# --- Volcano Engine Ark (Seedance) ---
# Create one at https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seedance-2-5-260628
# International BytePlus ModelArk (optional)
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ARK_MODEL=dreamina-seedance-2-5-260628

# --- Alibaba Cloud Model Studio (Wan 3.0 video) ---
# Create one at https://modelstudio.console.alibabacloud.com (API keys are per region)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
DASHSCOPE_MODEL=wan3.0-video
